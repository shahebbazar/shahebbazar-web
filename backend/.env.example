# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=shahebbazar
PGUSER=postgres
PGPASSWORD=postgres

# Express API
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Development analytics
ANALYTICS_SALT=shahebbazar-local-dev

# Vendor marketing package: show the owner's Marketing pages and routes (admin pass management is always on)
MARKETING_WORKSPACE_ENABLED=true
# Signs unsubscribe links (optional; defaults to a key derived from OTP_HASH_SECRET). Set it in production.
# UNSUBSCRIBE_SECRET=
# Site address used in unsubscribe links (defaults to the first CORS_ORIGIN)
# PUBLIC_SITE_URL=https://shahebbazar.com
# API address used in email links and images (defaults to http://localhost:PORT)
# PUBLIC_API_URL=https://api.shahebbazar.com

# Campaign emails (KAN-286). Off: each email is printed to this console instead of sent.
# To see real emails locally, run docker compose up -d (it starts Mailpit), set the lines
# below to true / localhost / 1025, and open http://localhost:8025.
# In production, use the email provider's SMTP settings. Never commit real keys.
MARKETING_EMAIL_ENABLED=false
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# The address emails come from; the business name is shown as "<Business> via Shahebbazar".
# MARKETING_EMAIL_FROM=offers@shahebbazar.com

# Phase 1 mock phone verification
MOCK_VERIFICATION_DELIVERY=console
OTP_HASH_SECRET=GENERATED_BY_SETUP