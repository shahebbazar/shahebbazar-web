# Settings for the client's server (deploy/client/docker-compose.yml). Copy to
# /var/www/apps/shahebbazar/.env, fill in and `chmod 600 .env`. It holds secrets: never commit it.
# See docs/DEPLOY-CLIENT.md.

# The site's host name, with its DNS pointing at the server. Traefik gets the HTTPS certificate.
SITE_HOST=staging.shahebbazar.com

# Database (only reachable on the private network). A long random password: openssl rand -hex 24
PGUSER=postgres
PGPASSWORD=
PGDATABASE=shahebbazar

# Secrets: a different long random value for each (openssl rand -hex 32).
OTP_HASH_SECRET=
UNSUBSCRIBE_SECRET=
ANALYTICS_SALT=

# Staging sign-in while there is no SMS: every sign-in code is this six-digit code. Share it with the
# team only. Leave empty once SMS delivery works.
DEMO_LOGIN_CODE=

# Sign-in codes by SMS through BulkSMSBD (bulksmsbd.net). All three set = codes are sent by SMS; the
# key is a secret, from the BulkSMSBD panel. The panel may need this server's IP (145.223.23.210)
# whitelisted, or every SMS is refused with code 1032. While DEMO_LOGIN_CODE is set, no SMS is sent.
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=

# Staging: the "Test site" strip and kept out of search engines. For the live site set
# TEST_BUILD=false and ROBOTS_HEADER= (empty).
TEST_BUILD=true
# ROBOTS_HEADER=

# The test inbox at https://<SITE_HOST>/mail: every campaign email lands there instead of being delivered.
MAIL_UI_USER=team
MAIL_UI_PASSWORD=

# Campaign email: the test inbox by default. For the client's email provider, set its SMTP details.
# SMTP_HOST=shahebbazar-mail
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MARKETING_EMAIL_FROM=offers@shahebbazar.com
