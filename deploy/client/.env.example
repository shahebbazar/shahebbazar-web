# Settings for one site on the client's server (deploy/client/docker-compose.yml). Copy to .env in the
# site's workspace, for example /var/www/apps/shahebbazar-test/.env, fill in and `chmod 600 .env`. It
# holds secrets: never commit it. See docs/DEPLOY-CLIENT.md.

# The workspace's name: shahebbazar-test or shahebbazar-prod. It names the site's containers, data
# volumes and private network (net_<PROJECT>). Staging (/var/www/apps/shahebbazar) leaves it out.
PROJECT=shahebbazar-test

# What deploy/client/deploy.sh takes: main (staging, from GitHub after each merge), branches (the test
# site, any branch from Run workflow) or manual (the live site: main, by hand on the server only).
DEPLOY_MODE=branches

# The site's host name, with its DNS pointing at the server. Traefik gets the HTTPS certificate.
SITE_HOST=test.shahebbazar.com
# The live site only: www.shahebbazar.com, which sends visitors on to SITE_HOST.
# WWW_HOST=

# Database (only reachable on the private network). A long random password: openssl rand -hex 24
PGUSER=postgres
PGPASSWORD=
PGDATABASE=shahebbazar

# What an empty database is loaded with, on the site's first start: demo (businesses, accounts and
# photos to try things with) or, for the live site, reference (locations, categories and marketing
# passes only). Reference also needs ADMIN_PHONE, the mobile number of the first admin, who signs in
# with a code by SMS; the API won't start without it. Changing either later has no effect.
# DB_SEED=reference
# ADMIN_PHONE=

# Secrets: a different long random value for each (openssl rand -hex 32).
OTP_HASH_SECRET=
UNSUBSCRIBE_SECRET=
ANALYTICS_SALT=

# Staging sign-in while there is no SMS: every sign-in code is this six-digit code. Share it with the
# team only. Leave empty once SMS delivery works.
DEMO_LOGIN_CODE=

# Sign-in codes by SMS through BulkSMSBD (bulksmsbd.net). All three set = codes are sent by SMS; the
# key is a secret, from the BulkSMSBD panel. The panel may need this server's IP (145.223.23.210)
# whitelisted, or every SMS is refused with code 1032. While DEMO_LOGIN_CODE is set, no SMS is sent.
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=

# Staging and the test site: the "Test site" strip and kept out of search engines. For the live site set
# TEST_BUILD=false and ROBOTS_HEADER= (empty).
TEST_BUILD=true
# ROBOTS_HEADER=

# The test inbox at https://<SITE_HOST>/mail: every campaign email lands there instead of being delivered.
MAIL_UI_USER=team
MAIL_UI_PASSWORD=
# The live site only, once SMTP_* below are set: TEST_INBOX=0 leaves the test inbox out.
# TEST_INBOX=0

# Campaign email: the test inbox by default. For real delivery, the Hostinger mailbox: smtp.hostinger.com,
# port 465, SMTP_SECURE=true, SMTP_USER=offers@shahebbazar.com (docs/DEPLOY-CLIENT.md, "Going live").
# SMTP_HOST=<PROJECT>-mail
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MARKETING_EMAIL_FROM=offers@shahebbazar.com
