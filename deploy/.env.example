# Settings for the server (deploy/docker-compose.yml). Copy to deploy/.env on the server and fill in.
# deploy/.env holds secrets: it is never committed (see .gitignore). See docs/DEPLOY.md.

# The address people use. With no domain, use the server's public IP written with dashes and
# .sslip.io, for example 13.55.1.2 -> 13-55-1-2.sslip.io. Caddy gets the HTTPS certificate itself.
SITE_ADDRESS=13-55-1-2.sslip.io
SITE_URL=https://13-55-1-2.sslip.io

# Database (only reachable inside the stack). Use a long random password:
#   openssl rand -hex 24
PGUSER=postgres
PGPASSWORD=
PGDATABASE=shahebbazar

# Secrets: a different long random value for each (openssl rand -hex 32).
OTP_HASH_SECRET=
UNSUBSCRIBE_SECRET=
ANALYTICS_SALT=

# Test server sign-in while there is no SMS: every sign-in code is this six-digit code. Share it with
# the team only. Leave empty once SMS delivery works.
DEMO_LOGIN_CODE=
# Sign-in codes by SMS through BulkSMSBD: SMS_PROVIDER=bulksmsbd, the key from its panel and the sender
# ID. Leave empty on the test server (its codes are the demo code).
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=

# Shows the "Test site" strip and keeps the site out of search engines. false for the live site.
TEST_BUILD=true

# The test inbox at <SITE_URL>/mail: every campaign email lands there instead of being delivered.
MAIL_UI_USER=team
MAIL_UI_PASSWORD=

# Campaign email: the test inbox by default. For the client's email provider, set its SMTP details.
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MARKETING_EMAIL_FROM=offers@shahebbazar.com
