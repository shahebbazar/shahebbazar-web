{
  "name": "shahebbazar-web",
  "version": "1.0.0",
  "description": "Shahebbazar — Rajshahi local business directory. Express API + Next.js frontend.",
  "private": true,
  "scripts": {
    "setup": "npm --prefix backend install && npm --prefix frontend/shahebbazar install",

    "dev": "concurrently -n api,web -c blue,magenta --kill-others-on-fail \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --prefix backend run dev",
    "dev:web": "npm --prefix frontend/shahebbazar run dev",

    "build": "npm --prefix frontend/shahebbazar run build",
    "start": "concurrently -n api,web -c blue,magenta --kill-others-on-fail \"npm:start:api\" \"npm:start:web\"",
    "start:api": "npm --prefix backend run start",
    "start:web": "npm --prefix frontend/shahebbazar run start",

    "db:load": "npm --prefix backend run db:load",
    "db:reset": "npm --prefix backend run db:reset",
    "db:verify": "npm --prefix backend run db:verify",
    "test": "npm --prefix backend test",
    "docs:erd": "npm --prefix backend run docs:erd",

    "lint": "npm --prefix frontend/shahebbazar run lint",
    "typecheck": "npm --prefix frontend/shahebbazar exec tsc -- --noEmit"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
